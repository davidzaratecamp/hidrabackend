# =============================================================================
# Configuración de Hidra — copiar a `.env` y completar
# =============================================================================
# `src/config/env.js` valida este archivo al arrancar. Si falta una variable
# obligatoria o tiene un valor inválido, el servidor NO arranca y dice cuál es.
# =============================================================================

# --- Aplicación --------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Base pública del frontend. Se usa para armar los links de los correos.
# OJO: si apunta a producción, los links de "reenviar formulario" llevan al
# frontend de producción, que consulta OTRA base de datos.
FRONTEND_URL=http://localhost:5173

# --- Base de datos -----------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ReclutamientoNuevo
DB_POOL_LIMIT=10

# --- Base histórica (solo lectura, opcional) ---------------------------------
# Base del sistema anterior, que se conserva intacta. Alimenta la consulta de
# candidatos antiguos (/api/historico). Sin DB_HISTORICO_NAME esa pantalla queda
# desactivada y el resto del sistema funciona igual.
# Host, puerto y credenciales se heredan de la base principal si no se indican.
# En producción, lo correcto es un usuario de MySQL con permiso SELECT y nada
# más sobre esta base: el archivo no se debe poder modificar.
DB_HISTORICO_NAME=noviembrehidra
# DB_HISTORICO_HOST=
# DB_HISTORICO_PORT=3306
# DB_HISTORICO_USER=consulta_historico
# DB_HISTORICO_PASSWORD=
DB_HISTORICO_POOL_LIMIT=5

# --- Autenticación -----------------------------------------------------------
# Mínimo 32 caracteres. No hay valor por defecto: sin esto el servidor no
# arranca. Generar con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_ISSUER=hidra
BCRYPT_ROUNDS=12

# --- Límite de peticiones ----------------------------------------------------
RATE_LIMIT_VENTANA_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_LOGIN_MAX=10

# --- Archivos ----------------------------------------------------------------
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=10485760

# --- Integraciones (opcionales) ----------------------------------------------
# Si faltan, el servidor arranca igual y solo falla la integración concreta.

# Correo (SMTP)
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Firma electrónica
FIRMACLOUD_API_URL=
FIRMACLOUD_API_KEY=

# Nómina (desprendibles)
NOMINA_BASE_URL=
API_KEY_NOMINA=
