    "test:watch": "vitest",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "migrate": "node db/migrate.js",
    "migrate:estado": "node db/migrate.js --estado",
    "db:reset": "node db/migrate.js --reset"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Backend del sistema de reclutamiento Hidra",
